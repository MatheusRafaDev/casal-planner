# ==========================================
# Casal Planner — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores.
# NUNCA suba o .env para o git (já está no .gitignore).
# ==========================================

# ==========================================
# Configurações do Servidor
# ==========================================
# CORS: Permite que o frontend acesse a API
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://localhost:8081

# ==========================================
# Autenticação (JWT)
# ==========================================
# Segredos para geração e validação de tokens JWT
# JWT_SECRET_KEY deve ter no mínimo 32 caracteres
JWT_SECRET_KEY=your_jwt_secret_key_here_min_32_chars
JWT_ISSUER=CasalPlanner
JWT_AUDIENCE=CasalPlannerUsers
# Tempo de expiração do token em minutos
JWT_EXPIRES_IN=60

# Google OAuth (para Login/Cadastro com Google — POST /api/auth/google)
GOOGLE_CLIENT_ID=your_google_client_id_here

# ==========================================
# Banco de Dados (MongoDB)
# ==========================================
MONGODB_CONNECTION_STRING=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_DATABASE=CasalPlannerDB

# ==========================================
# IA de Visão (Google Gemini) — PRIMÁRIO
# ==========================================
# Chave gratuita do Google AI Studio: https://ai.google.dev
# Modelo usado: gemini-2.5-flash
# Modelos disponíveis: https://ai.google.dev/gemini-api/docs/models
# Se o modelo for descontinuado, atualize GeminiVisionService.cs → const Model
GEMINI_API_KEY=your_gemini_api_key_here

# ==========================================
# IA e Processamento de Imagens (Groq) — FALLBACK de Visão
# ==========================================
# Usado como FALLBACK quando o Gemini falhar.
# Obtenha sua chave gratuita em: https://console.groq.com
# Modelo de visão ativo (agosto 2026): qwen/qwen3.6-27b
# Se o modelo for descontinuado, verifique: https://console.groq.com/docs/deprecations
GROQ_API_KEY=your_groq_api_key_here
# Delay artificial (ms) entre requisição e chamada à IA (0 para desativar)
IA_CALL_DELAY_MS=0

# ==========================================
# Pesquisa Online (Google Shopping via SerpAPI)
# ==========================================
# Usado para buscar preços online de produtos.
# Obtenha sua chave em: https://serpapi.com
SERPAPI_KEY=your_serpapi_key_here

# ==========================================
# Upload de Imagens (Cloudinary)
# ==========================================
# Usado para armazenar fotos enviadas pelos usuários.
# Crie uma conta gratuita em: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ==========================================
# Notificações e E-mail
# ==========================================
# Resend (serviço primário de e-mail)
# Obtenha uma chave gratuita em: https://resend.com
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=onboarding@resend.dev

# SMTP (fallback — usado se o Resend falhar)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=noreply@casalplanner.com
SMTP_FROM_NAME=CasalPlanner
