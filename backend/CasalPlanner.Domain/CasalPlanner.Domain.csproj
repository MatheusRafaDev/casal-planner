<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only needed because entities carry Bson mapping attributes.
         If you want a 100% persistence-agnostic Domain, move the
         [BsonId]/[BsonElement] attributes to Infrastructure via
         class maps instead of attributes. -->
    <PackageReference Include="MongoDB.Driver" Version="3.3.0" />
  </ItemGroup>

</Project>
